node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Local-only / not for the repo
backups/
.tools/
verify-shots/
*.exe

# NovaScribe local audio storage (runtime)
backend/.novascribe-data/
.novascribe-data/

# Reference source of the MediScribe app (already ported into backend/src/products/mediscribe + src/mediscribe)
AI_medical_scribe/

# Scratch screenshot helpers (mint a JWT, read prod) — never commit.
backend/_*.mjs
backend/scripts/_tmp*.ts

# The reference DROP folders stay out of git. `mediscribe-app/` (no suffix) is the
# real native app and IS tracked — it was copied from the reference verbatim.
mediscribe-app (*)/
novascribe-ai*/

# Firebase / FCM credentials.
#
# The SERVICE ACCOUNT key is a real secret: anyone holding it can send push
# notifications as us. It is uploaded to EAS and must never sit in the repo.
#
# google-services.json is NOT secret (it ships inside every Android app), but it
# is per-Firebase-project config that differs between environments, so it is
# kept out of git too and placed by whoever builds.
**/google-services.json
**/GoogleService-Info.plist
**/*service-account*.json
**/firebase-adminsdk-*.json
